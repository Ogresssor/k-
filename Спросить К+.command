#!/bin/bash
# Двойной щелчок — и можно задавать вопросы агенту.
cd "$(dirname "$0")" || exit 1

# macOS помечает всё скачанное из интернета «карантином», и тогда двойной
# щелчок по файлу молча не срабатывает — с Sequoia даже правая кнопка
# «Открыть» больше не помогает. Снимаем метку со своей папки и возвращаем
# право на запуск: обе операции касаются только файлов самой программы.
chmod +x ./*.command ./kplus ./run_server.sh 2>/dev/null || true
xattr -dr com.apple.quarantine . 2>/dev/null || true
clear

if [ ! -d .venv ]; then
  echo "Агент ещё не настроен."
  echo "Сначала запустите «Настроить.command» — он рядом, в этой же папке."
  echo
  read -r -p "Нажмите Enter, чтобы закрыть"
  exit 1
fi

cat <<'TXT'
╭──────────────────────────────────────────────────────────╮
│  Юридический помощник с доступом к КонсультантПлюс       │
╰──────────────────────────────────────────────────────────╯

Напишите, что нужно, обычными словами. Например:

  • Напиши претензию в страховую: не выплатили по ОСАГО
    после ДТП 12.03.2026, отказ от 05.04.2026.

  • Найди практику: можно ли взыскать неустойку, если
    страховая выплатила с опозданием на два месяца.

Готовые документы появятся в папке «Документы» рядом с программой.
Пустая строка — выход.

TXT

./.venv/bin/python -m kplus_mcp.cli
echo
echo "Готовые документы: папка «Документы» рядом с программой"
open "./Документы" 2>/dev/null
read -r -p "Нажмите Enter, чтобы закрыть"
