{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окну нужны свои команды и запросы к собственному агенту на 127.0.0.1.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    }
  ]
}
